// Shop — commerce data model.
// Learn more: https://pris.ly/d/prisma-schema
//
// MULTI-TENANCY
// -------------
// One database holds every merchant's store. Almost every model therefore
// carries a `shopId`, and no query may read one without filtering on it —
// lib/data/shop.ts returns a Prisma client that applies the filter and stamps
// it on writes, and scripts/check-scoped-queries.ts fails the build if a call
// site slips past it.
//
// Rule of thumb when adding a model: if two merchants could each have their
// own, it needs a shopId and a relation to Shop with onDelete: Cascade.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What a shop is doing right now.
//
// A state machine rather than a set of booleans, because the states are
// mutually exclusive and the transitions matter: a shop that is PAST_DUE is not
// simply "paused", and re-activating it is a different action from unpausing.
// Billing is not built yet, but PAST_DUE and SUSPENDED exist now so that adding
// it later is not another migration over every row.
/// What kind of business a shop is.
///
/// Asked once during onboarding and changeable afterwards. It filters the theme
/// picker and decides the vocabulary the admin uses — products, posts or dishes
/// — so it is a setting rather than a fork: nothing about a shop is migrated
/// when it changes.
enum BusinessType {
  ECOMMERCE
  BLOG
  RESTAURANT
}

/// Whether a post is written or out in the world.
enum ArticleStatus {
  DRAFT
  PUBLISHED
}

/// What a dish is suitable for. Flags on a product rather than a table: nobody
/// queries "all vegan things across all shops", they filter one menu by one.
enum Dietary {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  HALAL
  SPICY
}

enum ShopStatus {
  /// Free trial. Fully functional; no payment method yet.
  TRIAL
  /// Paying, or on a plan that needs no payment. The normal state.
  ACTIVE
  /// The merchant closed their own doors. Storefront shows a notice; the admin
  /// still works, so they can reopen.
  PAUSED
  /// Payment failed. Still serving, inside a grace period.
  PAST_DUE
  /// We turned it off — abuse, or grace period expired. Storefront is dark.
  SUSPENDED
  /// The merchant left. Data is kept for a retention window, then deleted.
  CLOSED
}

// What a person may do inside one shop.
//
// Deliberately per-membership rather than per-user: the same person can own one
// shop and be a stock clerk at another, and a role that meant something
// globally would make that impossible to express.
// What a one-time link is for.
//
// Separate purposes on one table rather than two tables, because the rules are
// identical — hashed at rest, single use, expiring — and only the landing page
// differs. Using one for the other is prevented by checking the purpose on
// redemption, not by hoping.
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// How far along a merchant's own domain is.
///
/// Deliberately a straight line rather than a set of flags. A domain is exactly
/// one of these at a time and the merchant is shown the same words, so "where
/// has this got to?" has one answer instead of four booleans to reconcile.
enum DomainStatus {
  /// Added, but nothing has been checked yet. The merchant is looking at the
  /// records they need to create at their registrar.
  PENDING
  /// The DNS records are right. The certificate is still being issued, which
  /// is nothing for the merchant to do but wait.
  VERIFIED
  /// Serving. Certificate issued and traffic is routing to us.
  ACTIVE
  /// We looked, repeatedly, and the records were absent or pointed elsewhere.
  FAILED
}

enum MemberRole {
  /// Billing, ownership transfer, deleting the shop. Exactly one per shop.
  OWNER
  /// Everything except billing and ownership.
  ADMIN
  /// Day-to-day: products, orders, enquiries. Not settings or staff.
  STAFF
  /// Read-only. For accountants and agencies.
  VIEWER
}

/// What a discount takes off.
///
/// FREE_SHIPPING is its own type rather than a 100% discount on the shipping
/// line, because the shipping fee is calculated after the discount and a
/// percentage would have to be applied to a number that does not exist yet.
enum DiscountType {
  /// `value` is a percentage, 1–100, off the subtotal.
  PERCENTAGE
  /// `value` is an amount in PKR off the subtotal.
  FIXED_AMOUNT
  /// Shipping is waived. `value` is ignored.
  FREE_SHIPPING
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  /// Paid through the PayFast gateway. One value per provider rather than a
  /// single "CARD", because which provider took the money is a fact about the
  /// order that a merchant will need when they reconcile their settlements.
  PAYFAST
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  CONFIRMED
  FAILED
}

/// Which hosted gateway a shop is connected to.
///
/// One value per provider rather than a generic "CARD", because the merchant
/// holds the account and the money goes to *their* bank — which provider it is
/// is a fact about the order, not an implementation detail. Adding a second
/// gateway adds a value here and an adapter in lib/payments/, and nothing else.
enum GatewayProvider {
  PAYFAST
}

/// Test or real money. Never inferred, always stored on the attempt, so an
/// order taken in sandbox can never be read later as revenue.
enum GatewayMode {
  SANDBOX
  LIVE
}

/// One attempt at paying for an order through a gateway.
///
/// Deliberately not the same thing as `PaymentStatus` on the order. A customer
/// may fail twice and succeed on the third go; the order has one payment state
/// and three attempts, and collapsing them loses the only record of what
/// actually happened.
enum PaymentAttemptStatus {
  /// Created, customer not yet sent to the gateway.
  INITIATED
  /// Customer is at the gateway. Nothing has been confirmed.
  PENDING
  /// Verified against the provider's own API. The only status that pays for an order.
  CONFIRMED
  /// The provider says it failed, or the customer came back without paying.
  FAILED
  /// The reservation window closed with no confirmation.
  EXPIRED
  /// The provider reports a payment whose amount, currency or order does not
  /// match what we asked for. Never confirmed, always surfaced to the merchant.
  MISMATCHED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MenuLocation {
  HEADER
  FOOTER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

// How a product is sold. This is the single switch that decides whether a
// product can be added to a cart at all, so it is deliberately an enum rather
// than a set of booleans that could contradict each other.
//
//   NORMAL — a price, variants, add to cart. The ordinary case.
//   BULK   — sold by arrangement. No cart: the buyer sends an enquiry, because
//            the price depends on quantity and is agreed, not published.
//   CUSTOM — made to order against measurements. Priced per commission, so it
//            is also enquiry-only.
enum ProductKind {
  NORMAL
  BULK
  CUSTOM
}

// What a BULK product shows where a price would go.
//
//   HIDDEN — "Price on request". For a seller who negotiates every deal.
//   RANGE  — "from X to Y". Sets expectations without committing.
//   TIERED — a table of quantity breaks, each with its own unit price. The most
//            informative, and the one that answers the buyer's real question:
//            what does it cost at the quantity I want?
enum BulkPricing {
  HIDDEN
  RANGE
  TIERED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  WON
  LOST
}

enum SectionType {
  HERO_SLIDESHOW
  BANNER
  CATEGORY_GRID
  FEATURED_PRODUCTS
  TEXT_BLOCK
  IMAGE_TEXT
  STORY
  FAQ_LIST
  /// Blog. Latest posts, newest first.
  ARTICLE_LIST
  /// Restaurant. Products grouped by category and priced, with no buy button —
  /// a menu to read, not a grid to shop.
  MENU_LIST
  /// Restaurant. When the shop is open.
  OPENING_HOURS
  /// Restaurant. Where the shop is.
  LOCATION_INFO
}

// A store. The tenant root: almost everything else in this file belongs to one.
model Shop {
  id        String     @id @default(cuid())
  name      String
  /// The address every shop gets for free: <subdomain>.shop.synoradigitals.com. Unique
  /// platform-wide, which is the one thing that genuinely must be.
  subdomain String     @unique
  status    ShopStatus @default(TRIAL)

  /// When the merchant finished, or skipped, the welcome flow. Null means they
  /// have not seen it. A timestamp rather than a boolean because "when did this
  /// shop start" is a question worth being able to answer later.
  onboardedAt DateTime?

  /// What the merchant said they run. Defaulted rather than nullable so every
  /// read is a value — a shop that skipped onboarding is an online store, which
  /// is what every shop on the platform was before the question existed.
  businessType BusinessType @default(ECOMMERCE)

  /// Set when the merchant pauses the shop, so "how long has this been down"
  /// is answerable without an audit-log scan.
  pausedAt DateTime?
  /// Set when CLOSED. Data is retained until the window expires.
  closedAt DateTime?

  members           Membership[]
  staffInvites      StaffInvite[]
  domains           Domain[]
  discounts         Discount[]
  redemptions       DiscountRedemption[]
  customers         Customer[]
  categories        Category[]
  products          Product[]
  variants          ProductVariant[]
  orders            Order[]
  orderItems        OrderItem[]
  addresses         Address[]
  enquiries         Enquiry[]
  pages             Page[]
  sections          Section[]
  menuItems         MenuItem[]
  menus             Menu[]
  articles          Article[]
  openingHours      OpeningHours[]
  locations         Location[]
  metafields        Metafield[]
  media             MediaAsset[]
  visits            Visit[]
  reopenSignups     ReopenSignup[]
  siteTexts         SiteText[]
  settings          StoreSettings[]
  themes            ThemeSettings[]
  fonts             FontAsset[]
  stickyButtons     StickyButton[]
  redirects         Redirect[]
  paymentGateways   PaymentGateway[]
  payments          Payment[]
  paymentEvents     PaymentEvent[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A person who signs in to Shop: a merchant or their staff.
//
// NOT a shopper. Email is unique platform-wide because this is one human's
// single identity across every shop they touch. Shoppers are Customer rows,
// which are per-shop — see that model for why the two cannot be one table.
model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  phone              String?
  /// Null until the address is confirmed. A store cannot go live before this:
  /// an unverified address is an unusable one, and password resets and order
  /// alerts would both vanish into it.
  emailVerifiedAt    DateTime?
  /// Sessions issued before this moment are refused. Changing a password or
  /// signing out everywhere moves it forward, which is what makes those
  /// actions mean anything against a token someone else already holds.
  sessionsValidFrom  DateTime            @default(now())
  memberships        Membership[]
  verificationTokens VerificationToken[]
  sentInvites        StaffInvite[]
  pushSubscriptions  PushSubscription[]
  adminOtps          AdminOtp[]
  auditLogs          AuditLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Which shops a user can act in, and as what.
// A one-time link sent by email: verify this address, or reset this password.
//
// Only the SHA-256 of the token is stored. The plaintext exists in exactly one
// place — the email — so a database dump cannot be turned into account
// takeovers, which is what makes password reset such a common way in.
model VerificationToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  purpose    TokenPurpose
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// Snapshotted, so a token issued for one address cannot verify another if
  /// the user changes their email mid-flight.
  email      String
  expiresAt  DateTime
  /// Single use. Set the moment it is redeemed, before anything else happens.
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// An invitation to join a shop's staff.
//
// Not a Membership with acceptedAt null: you invite an *address*, and the
// person behind it may have no account yet. A Membership needs a user; this
// does not, and becomes one when accepted.
/// A hostname that serves a shop.
///
/// Every shop has one of these for its free `<subdomain>.shop.synoradigitals.com` address
/// and may add its own. Keeping both in one table means host resolution has a
/// single path rather than "look here, and if that fails look there", and the
/// primary-domain rule below applies to the free address too.
///
/// `hostname` is unique platform-wide and not per shop, which is the point: two
/// merchants cannot both claim `shop.example.com`, and the first to *verify* it
/// keeps it. Verification is what settles the dispute, not who typed it first —
/// see lib/domains.ts.
model Domain {
  id       String       @id @default(cuid())
  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId   String
  /// Lowercase, no port, no trailing dot, no scheme. Normalised on the way in.
  hostname String       @unique
  status   DomainStatus @default(PENDING)

  /// The free platform address. Cannot be removed or edited, and is what a
  /// merchant falls back to if their own domain breaks.
  isPlatform Boolean @default(false)
  /// The canonical address. Every other domain for this shop redirects to it,
  /// so a store is never indexed twice under two names.
  isPrimary  Boolean @default(false)

  /// Proves the person adding the domain controls it, via a TXT record. Random
  /// per domain, so knowing one tells you nothing about another.
  verificationToken String
  /// When DNS last looked correct. Cleared if it stops being correct.
  verifiedAt        DateTime?
  /// When it last served real traffic — certificate issued and routing live.
  activatedAt       DateTime?
  /// Why the last check failed, in the words the merchant is shown.
  lastError         String?
  /// When we last looked, so a merchant can be told how fresh the answer is
  /// and so the checker can avoid hammering a registrar.
  lastCheckedAt     DateTime?
  /// How many times in a row the check has failed. Used to back off, and to
  /// stop checking a domain somebody added by mistake and abandoned.
  failedChecks      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([status])
}

/// A code a customer types at checkout to pay less.
///
/// Codes are per shop and compared case-insensitively — a customer typing
/// "save10" must match a merchant who created "SAVE10", so the code is stored
/// uppercase and uppercased again on lookup.
model Discount {
  id     String       @id @default(cuid())
  shop   Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String
  code   String
  type   DiscountType
  /// Percentage (1–100) or PKR amount, depending on `type`. Unused for
  /// FREE_SHIPPING.
  value  Int          @default(0)

  /// Smallest subtotal the order must reach to qualify, in PKR.
  minSubtotal      Int?
  /// Total redemptions allowed across every customer. Null means unlimited.
  usageLimit       Int?
  /// Redemptions allowed per customer. Null means unlimited.
  perCustomerLimit Int?
  /// Kept alongside the redemption rows so the limit can be enforced with one
  /// conditional update rather than a count under a lock.
  usageCount       Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  redemptions DiscountRedemption[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, code])
  @@index([shopId])
}

/// One use of a discount, by one order.
///
/// Separate from the counter on Discount because "how many times has *this
/// customer* used it" cannot be answered by a counter, and because a merchant
/// asking where the money went needs the orders, not a number.
model DiscountRedemption {
  id         String   @id @default(cuid())
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId     String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String
  /// The order that used it. Unique: an order carries at most one discount.
  orderId    String   @unique
  customerId String?
  /// What it actually took off, in PKR. Stored because the discount's rules
  /// can change afterwards and the order must still add up.
  amount     Int
  createdAt  DateTime @default(now())

  @@index([shopId])
  @@index([discountId])
  @@index([customerId])
}

model StaffInvite {
  id          String     @id @default(cuid())
  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      String
  email       String
  role        MemberRole @default(STAFF)
  tokenHash   String     @unique
  /// For the audit trail, and for "invited by" in the staff list.
  invitedBy   User?      @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  /// One outstanding invite per address per shop — re-inviting replaces it
  /// rather than leaving two live links to the same seat.
  @@unique([shopId, email])
  @@index([shopId])
}

// Counters for anything that must not be attempted without limit.
//
// A table rather than Redis, because this has to work on day one with the
// database that already exists, and at the traffic of a platform with tens of
// shops the difference is not measurable. lib/rate-limit.ts is the only thing
// that touches it, so swapping the store later is a one-file change.
model RateLimit {
  /// Scopes the counter: "login:ip:1.2.3.4", "enquiry:shop_abc:5.6.7.8".
  key          String    @id
  count        Int       @default(0)
  /// A row past its window is treated as absent.
  windowEnd    DateTime
  /// Set once a limit trips and a cool-off is being served.
  blockedUntil DateTime?

  @@index([windowEnd])
}

model Membership {
  id     String     @id @default(cuid())
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  shop   Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String
  role   MemberRole @default(STAFF)

  /// Set once the invite is accepted. Null means invited but not yet joined —
  /// which is not the same as having no access, and the difference is visible
  /// in the staff list rather than inferred.
  acceptedAt DateTime?
  invitedAt  DateTime  @default(now())

  @@unique([userId, shopId])
  @@index([shopId, role])
}

// A shopper at one shop.
//
// Separate from User, and unique per shop rather than globally, because the
// same person shopping at two different stores is two unrelated relationships:
// different addresses, different order history, and no reason for one merchant
// to learn that their customer also shops elsewhere. A single global user table
// cannot express that without leaking it.
model Customer {
  id           String    @id @default(cuid())
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId       String
  email        String
  name         String
  phone        String?
  passwordHash String?
  addresses    Address[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([shopId, email])
  @@index([shopId])
}

// Who did what. Written for every meaningful change, from the first one.
//
// Retrofitting this is impossible — the history you wanted is exactly the part
// you did not record — so it exists before the features that will use it.
model AuditLog {
  id         String  @id @default(cuid())
  shop       Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId     String
  /// Null for actions taken by the system rather than a person.
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  /// Kept even if the user is deleted, so the trail stays readable.
  actorEmail String?

  /// "product.delete", "shop.pause", "staff.invite".
  action   String
  /// What it happened to: "Product", "Order".
  entity   String?
  entityId String?
  /// Enough detail to answer "what changed", without storing the whole row.
  detail   Json?

  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, entity, entityId])
}

// One row per issued admin login code. Never reused across requests — a fresh
// row is created each time a code is sent, and old unconsumed rows are left to
// expire naturally. That's harmless: authorize() only trusts the most recent
// unconsumed, unexpired row, and the attempt cap is enforced per row.
model AdminOtp {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Address {
  id         String   @id @default(cuid())
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId     String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String   @default("Home")
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String?
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([shopId])
}

model Category {
  id             String    @id @default(cuid())
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId         String
  name           String
  slug           String
  image          String?
  /// Shown at the top of the collection page, above the grid. Optional —
  /// a collection with nothing worth saying should say nothing.
  description    String?
  /// Overrides the <title> and meta description for this collection. Falling
  /// back to the name is right far more often than not, so these stay empty
  /// until someone has a reason to differ.
  seoTitle       String?
  seoDescription String?
  products       Product[]
  // The auto-created collection page (see Page's comment). Cascades on
  // category delete.
  pages          Page[]

  @@unique([shopId, slug])
  @@index([shopId])
}

model Product {
  id          String   @id @default(cuid())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      String
  title       String
  slug        String
  description String
  details     String? // fabric, care instructions, etc. (markdown/plain text)
  images      String[]

  /// What this product's variant axes are called, in Shopify's shape: up to
  /// three freely named options. "Size" and "Colour" were hardcoded, which is
  /// two of the three products in Shopify's own template that could not be
  /// imported: a digital product sold by Format and a perfume sold by Title.
  option1Name String?
  option2Name String?
  option3Name String?

  /// Who makes it. Shopify's "Vendor", and the column merchants actually use.
  vendor String?
  /// Free tags. Shopify's are one comma separated cell; stored as a list.
  tags   String[] @default([])

  /// Columns from Shopify's product CSV that SHOP itself never reads, kept
  /// verbatim so an export can be diffed against a Shopify export and match.
  /// A JSON column rather than twenty real ones: thirteen of them are Google
  /// Shopping fields nothing in this platform will ever query.
  csvExtras  Json             @default("{}")
  basePrice  Int // stored in PKR, integer (no paisa)
  salePrice  Int?
  costPrice  Int              @default(0) // what you pay per unit, PKR — admin/profit-calc only, never sent to the storefront
  // Many-to-many — a product can sit in several categories at once (e.g. a discounted Lawn
  // piece is both "Lawn" and "Sale"). "Sale" membership is kept in sync with salePrice
  // automatically by saveProduct() rather than left to the admin to remember — see actions.ts.
  categories Category[]
  variants   ProductVariant[]
  isFeatured Boolean          @default(false)
  isActive   Boolean          @default(true)
  status     ProductStatus    @default(PUBLISHED) // DRAFT = half-configured/unpublished, hidden from storefront regardless of isActive

  // --- How this product is sold -------------------------------------------
  // NORMAL products use basePrice/salePrice/variants above and nothing below.
  kind             ProductKind @default(NORMAL)
  /// Dietary flags, for a shop serving food. Empty for everything else, so this
  /// costs a non-food shop nothing.
  dietary          Dietary[]   @default([])
  /// BULK only: how the price is presented. See the BulkPricing enum.
  bulkPricing      BulkPricing @default(HIDDEN)
  /// BULK only: smallest order the seller will take, in units.
  minOrderQuantity Int?
  /// BULK + RANGE: the advertised span, in PKR per unit.
  bulkPriceMin     Int?
  bulkPriceMax     Int?
  /// BULK + TIERED: quantity breaks, as [{ minQty, unitPrice }] ordered by
  /// minQty. Stored as JSON rather than a table because tiers are only ever
  /// read as a whole, alongside their product, and never queried across it.
  bulkTiers        Json?
  /// CUSTOM only: the measurements or choices a buyer must supply, as
  /// [{ id, label, help, required, kind }]. Same reasoning as bulkTiers.
  customFields     Json?
  /// BULK/CUSTOM: where the enquiry button sends the buyer. Empty means the
  /// built-in enquiry form. Any other value is validated as a safe URL before
  /// it is stored and again before it is rendered.
  enquiryUrl       String?
  enquiries        Enquiry[]
  deletedAt        DateTime? // set when moved to the admin Bin (soft delete) — hidden everywhere until restored or permanently deleted
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  /// Kept while the option columns are filled in and every reader is moved
  /// across. See the expand and contract migration in
  /// 20261011000000_variant_named_options.
  size      String
  color     String
  colorHex  String?

  /// The variant's position on each of its product's named axes. option1 holds
  /// what size held; option2 holds what color held.
  option1 String @default("")
  option2 String @default("")
  option3 String @default("")

  barcode       String?
  weightGrams   Int?
  imageUrl      String?
  /// As above: the per variant columns SHOP does not model, kept for a
  /// lossless round trip.
  csvExtras     Json        @default("{}")
  sku           String
  stock         Int         @default(0)
  priceOverride Int?
  orderItems    OrderItem[]

  @@unique([shopId, sku])
  @@unique([productId, size, color])
  @@unique([productId, option1, option2, option3])
  @@index([productId])
  @@index([shopId])
}

model Order {
  id                  String        @id // short 5-char id, assigned in app code — see lib/order-id.ts
  shop                Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId              String
  customer            Customer?     @relation(fields: [customerId], references: [id])
  customerId          String?
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingLine1       String
  shippingLine2       String?
  shippingCity        String
  shippingProvince    String
  shippingPostalCode  String?
  items               OrderItem[]
  subtotal            Int
  shippingFee         Int
  total               Int
  paymentMethod       PaymentMethod
  discount            Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId          String?
  /// Copied at checkout so the order still shows what was used even if the
  /// discount is later renamed or deleted.
  discountCode        String?
  discountAmount      Int           @default(0)
  paymentStatus       PaymentStatus @default(PENDING)
  orderStatus         OrderStatus   @default(PENDING)
  transactionProofUrl String?
  notes               String?
  /// When an unpaid gateway order stops holding its stock.
  ///
  /// Stock is decremented when the order is written, before the customer has
  /// paid — otherwise two people buy the last item and one of them pays for
  /// something that does not exist. The cost of that choice is a customer who
  /// wanders off at the gateway and silently locks up inventory, so a gateway
  /// order carries a deadline. Past it, the order is cancelled and the stock
  /// goes back. Null for Cash on Delivery and the manual methods, which are
  /// not waiting on anything.
  reservedUntil       DateTime?
  payments            Payment[]
  deletedAt           DateTime? // set when moved to the admin Bin (soft delete) — excluded from every revenue/profit aggregate until restored
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([customerId])
  @@index([shopId, createdAt])
  @@index([shopId, orderStatus])
}

model OrderItem {
  id        String          @id @default(cuid())
  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  // Optional + SetNull so a Product/ProductVariant can be permanently deleted (from the Bin)
  // even if it has order history — the snapshot fields below already fully describe the line
  // item independent of the product/variant still existing.
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?
  title     String // snapshot of product title at time of order
  size      String
  color     String
  price     Int
  costPrice Int             @default(0) // snapshot of product cost at time of order — profit calc stays accurate if cost changes later
  quantity  Int

  @@index([orderId])
  @@index([shopId])
}

// A shop's connection to a hosted payment gateway.
//
// The platform is not a party to these payments. The merchant holds the account
// with the provider, the provider settles into the merchant's own bank, and
// this row holds only the credentials needed to speak to the provider on the
// merchant's behalf. Nothing about this is a payment aggregator, and it must
// stay that way: the moment money passes through a platform account this stops
// being software.
//
// The credentials are a sealed blob, not columns. See lib/payments/crypto.ts —
// AES-256-GCM, keyed from the environment, with the shop id and the provider
// bound in as additional authenticated data so a row lifted into another shop's
// id will not decrypt at all rather than decrypting into somebody else's money.
model PaymentGateway {
  id       String          @id @default(cuid())
  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId   String
  provider GatewayProvider

  /// Test or live. A gateway starts in SANDBOX and cannot leave it until a real
  /// sandbox payment has completed end to end — see sandboxVerifiedAt.
  mode GatewayMode @default(SANDBOX)

  /// Whether the storefront offers it. Separate from having credentials on
  /// purpose: switching a gateway off for an afternoon must not make the
  /// merchant fetch their keys from the provider again to switch it back on.
  isActive Boolean @default(false)

  /// The sealed credentials. Null once disconnected — disconnecting wipes them
  /// rather than merely hiding them.
  secret     Bytes?
  /// Which environment key sealed `secret`, so keys can be rotated without
  /// every merchant re-entering theirs.
  keyVersion Int    @default(1)

  /// Set the first time credentials were accepted; kept across replacements, so
  /// "connected since" survives a key rotation at the provider's end.
  connectedAt          DateTime?
  /// Set every time the credentials are replaced.
  credentialsUpdatedAt DateTime?

  /// The go-live gate. Set only by a sandbox payment that reached CONFIRMED
  /// through the one verification path, never by saving a form. Until it is
  /// set, LIVE cannot be selected.
  sandboxVerifiedAt DateTime?
  /// The first live payment that confirmed. Informational.
  liveVerifiedAt    DateTime?

  /// The last time the credentials were exercised against the provider, and
  /// what went wrong if it failed. Shown to the merchant so a key that has been
  /// revoked at the provider's end is visible before a customer finds it.
  lastCheckedAt DateTime?
  lastError     String?

  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([shopId, provider])
  @@index([shopId])
}

// One attempt at paying for one order through a gateway.
//
// Kept apart from the order's own paymentStatus because an attempt can fail
// without anything about the order changing, and because the amount asked for
// has to be recorded at the moment it is asked for: verification compares what
// the provider says was paid against this row, not against the order, so a
// later edit to the order cannot retroactively make an underpayment match.
model Payment {
  id      String @id @default(cuid())
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId  String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  gateway   PaymentGateway? @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  gatewayId String?
  provider  GatewayProvider
  mode      GatewayMode

  /// What we hand the provider as the basket/order reference, and what comes
  /// back on the callback.
  ///
  /// Globally unique and random, not the order id: order ids are five
  /// characters and unique only within a shop, so two shops routinely hold the
  /// same one. Sent as a shared reference, that is one shop confirming another
  /// shop's order. It is also unguessable, which matters because it is the only
  /// thing a callback carries.
  reference String @unique

  /// Minor-unit integer, in the same units as Order.total, frozen at the moment
  /// the attempt was created.
  amount   Int
  currency String

  /// What the provider needs back before it will answer a question about this
  /// payment, recorded when the customer was sent to pay.
  ///
  /// Neither is recoverable afterwards. The IP belonged to a browser that has
  /// gone, and the order date must be the exact string that was sent rather
  /// than a re-derivation of it — a second's difference in formatting and the
  /// provider does not recognise the request. PayFast requires both to return
  /// a transaction's status, so a payment written without them cannot be
  /// verified at all, which is why they are captured at the start and never
  /// computed at the end.
  customerIp String?
  orderDate  String?

  status        PaymentAttemptStatus @default(INITIATED)
  /// The provider's own transaction id, once known. Unique per provider, which
  /// is what makes a replayed callback a no-op rather than a second payment.
  providerRef   String?
  failureReason String?
  verifiedAt    DateTime?

  /// When this attempt stops being answerable and its order releases stock.
  expiresAt DateTime

  events    PaymentEvent[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([provider, providerRef])
  @@index([shopId, orderId])
  @@index([status, expiresAt])
}

// Everything that ever claimed something about a payment.
//
// Written before a claim is acted on, including claims that turn out to be
// forged or to name nothing at all. A callback endpoint is public by necessity
// — the provider must be able to reach it and cannot authenticate to us — so
// the record of who said what, from which address, is the only account of an
// attempt to be paid for nothing.
//
// shopId is nullable on purpose: an event that resolves to no known payment
// belongs to no shop, and pretending otherwise would file a stranger's forgery
// in a merchant's records.
model PaymentEvent {
  id        String          @id @default(cuid())
  shop      Shop?           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String?
  payment   Payment?        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String?
  provider  GatewayProvider

  /// Where the claim arrived from: "callback", "return", "sweep", "connect".
  source  String
  /// What was decided: "confirmed", "already-confirmed", "failed", "mismatch",
  /// "unknown-reference", "expired", "provider-error".
  outcome String
  detail  String?
  ip      String?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([shopId, createdAt])
  @@index([createdAt])
}

// A browser's Web Push subscription, registered from the admin panel so the
// owner gets an instant notification (no app store publishing required) when
// a new order comes in. One admin can have several (phone + laptop, etc).
model PushSubscription {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // Stays globally unique: the endpoint is minted by the browser's push
  // service and is already unique across the internet, so scoping it per shop
  // would let one device register twice for the same notifications.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([shopId])
}

// One row per shop, holding store-wide configuration editable from the admin
// panel. A shop that has never opened Settings has no row at all and falls back
// to the defaults in lib/data/settings.ts.
model StoreSettings {
  id                      String  @id @default(cuid())
  shop                    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId                  String
  /// Which menu fills each slot. Null falls back to the shop's first menu, so a
  /// store is never left with no navigation because an assignment was cleared.
  headerMenuId            String?
  footerMenuId            String?
  whatsappNumber          String  @default("923218408190")
  contactEmail            String? // shown on the Contact page
  bankAccountDetails      String? // shown at checkout for Bank Transfer
  jazzcashAccountDetails  String?
  easypaisaAccountDetails String?
  shippingFee             Int     @default(250)
  freeShippingThreshold   Int?

  // --- Global Edits ---------------------------------------------------
  // Site-wide behavior toggles/values read live everywhere they apply —
  // including by products/pages created after the edit was made. Off/empty
  // always means "the site's original, unmodified behavior" — see
  // lib/global-edits.ts for the shared defaults and pure helpers.
  showInventoryCount   Boolean @default(true)
  lowStockThreshold    Int     @default(5)
  lowStockBadgeText    String  @default("Only {n} left!")
  outOfStockDisplay    String  @default("SOLD_OUT") // "HIDE" | "SOLD_OUT" | "NORMAL"
  newArrivalBadge      Boolean @default(true)
  newArrivalWindowDays Int     @default(14)
  newArrivalBadgeText  String  @default("New")
  saleBadge            Boolean @default(true)
  defaultShopSort      String  @default("newest") // "newest" | "price-asc" | "price-desc" | "featured"
  shopGridColumns      Int     @default(4) // 3 | 4 | 5
  accentColor          String  @default("#4c100f")
  headingStyle         String  @default("normal") // "normal" | "uppercase" | "titlecase"
  footerCopyrightText  String  @default("© {year} Your Store. All rights reserved.")
  announcementText     String  @default("")
  announcementBgColor  String  @default("#4c100f")
  whatsappOrderButton  Boolean @default(true)
  maintenanceMode      Boolean @default(false)

  /// Which ways a customer may pay, per shop.
  ///
  /// This used to be a constant in lib/payment-methods.ts — one list for the
  /// whole platform, set to COD only "temporarily, per request". Meanwhile
  /// Settings offered every merchant three boxes for their bank, JazzCash and
  /// EasyPaisa details under the words "leave one blank and it is not offered",
  /// which was not true in either direction: filling them in offered nothing,
  /// and no merchant could turn a method on.
  ///
  /// Empty is read as COD, never as "no way to pay" — a checkout with no
  /// payment method is a shop that cannot take an order, and a migration or a
  /// bad save must not be able to produce one.
  enabledPaymentMethods String[] @default(["COD"])

  // --- The shop's marks ---------------------------------------------------
  // Its logos and its favicon. Here rather than in ThemeSettings because they
  // belong to the business, not to the storefront it is currently wearing:
  // theme tokens are stored per business type, so a merchant who switched from
  // a shop to a restaurant and back lost their logo twice over. Same company,
  // same mark.
  //
  // Four slots on two axes — wide or compact, light or dark background — and
  // only the first is ever needed. lib/brand-marks.ts holds the fallback order
  // a theme walks when it asks for a combination the merchant has not filled
  // in, so a theme is never handed nothing.
  //
  // Set on Home and nowhere else. That is the rule the whole arrangement is
  // for: one place to change a logo.
  logoUrl            String @default("")
  logoDarkUrl        String @default("")
  logoCompactUrl     String @default("")
  logoCompactDarkUrl String @default("")
  /// The browser tab icon. SVG, PNG or ICO — see FAVICON_FORMATS. Other
  /// formats upload happily and then do not render on a tab, which is a fault
  /// nobody can diagnose from inside the panel.
  faviconUrl         String @default("")

  // --- The holding page ---------------------------------------------------
  // What customers are shown when the store is not open to them. One page for
  // two situations: maintenanceMode above, and the shop being PAUSED. They are
  // different switches but the same moment from a customer's side — the store
  // is shut and the merchant is working — and asking a merchant to write the
  // same notice twice is how one of them ends up stale.
  //
  // "Closed" and "suspended" keep our wording and are not editable here. A
  // store that has closed for good is not the merchant's message to write to
  // someone waiting on an order, and a suspension is ours, not theirs.
  //
  // Empty means "use the words we wrote". Stored empty rather than seeded with
  // the default text so that improving the default reaches every shop that has
  // not written its own, instead of freezing a copy in every row on the day
  // this shipped.
  maintenanceHeading  String  @default("")
  maintenanceMessage  String  @default("")
  /// Empty falls back to the theme's own logo, so the page is branded without
  /// the merchant having to upload anything twice.
  maintenanceLogoUrl  String  @default("")
  maintenanceShowLogo Boolean @default(true)
  /// Whether the page offers to tell visitors when the store reopens.
  maintenanceSignups  Boolean @default(false)

  /// Countries this shop will not serve, as ISO 3166-1 alpha-2 codes.
  ///
  /// A visitor whose country is on this list sees the closed-store page rather
  /// than the shop, the same way maintenance mode works — the merchant's own
  /// staff still get through, so they can check what a blocked visitor sees.
  ///
  /// Country comes from the edge, not from the visitor: Vercel resolves it into
  /// x-vercel-ip-country before our code runs, so there is nothing to look up
  /// and nothing to pay for. It is a country-level signal and no more than
  /// that — a VPN defeats it, which is the honest limit of blocking by address
  /// and the reason this is worded as hiding rather than as security.
  blockedCountries String[] @default([])

  /// Whether search engines are invited in — see app/robots.ts.
  ///
  /// On by default, because a shop nobody can find is not a shop. A merchant
  /// turns it off while a store is being built, or for a private catalogue that
  /// is meant to be shared by link only. It is an instruction, not a lock:
  /// robots.txt is obeyed by search engines and ignored by everything else.
  searchIndexing Boolean @default(true)

  /// Whether public forms carry the honeypot field — see lib/spam.ts.
  ///
  /// On by default. A merchant only turns it off to diagnose a genuine
  /// submission that went missing, which is the one case where a silent filter
  /// is worse than the spam it stops.
  spamProtection Boolean @default(true)

  // --- Store defaults -----------------------------------------------------
  // The facts about the business that everything else is expressed in: what
  // it's called, what it charges in, where it trades from, and what "now"
  // means when an order is stamped. Kept together because they are what a
  // merchant sets once, on day one, and then rarely thinks about again.
  storeName     String  @default("Your Store")
  currency      String  @default("PKR")
  countryCode   String  @default("PK")
  /// "METRIC" or "IMPERIAL" — drives which weight and length units are offered.
  unitSystem    String  @default("METRIC")
  weightUnit    String  @default("kg")
  /// IANA zone. Orders and analytics are recorded against this, so changing it
  /// changes which day a sale belongs to.
  timeZone      String  @default("Asia/Karachi")
  shopFilterBar Boolean @default(true)

  @@unique([shopId])
}

/// Someone who asked to be told when a shut store opens again.
///
/// Deliberately not a Customer. A Customer has a name, an address book and an
/// order history, and half of that is required; a visitor who typed an email
/// into a holding page has given us one field and no permission to treat them
/// as having shopped here. Writing them into Customer would mean inventing a
/// name for them, and would put people who have never bought anything into
/// every count, export and mailing the merchant runs.
///
/// So: its own small table, its own screen, its own export, and deletable on
/// request without touching anything else. The email is the only thing stored.
model ReopenSignup {
  id         String    @id @default(cuid())
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId     String
  email      String
  /// When they asked. Also the consent record — this is the whole of what they
  /// agreed to, so the time they agreed is the only other fact worth keeping.
  createdAt  DateTime  @default(now())
  /// Set when the merchant has marked them told, so reopening twice does not
  /// mean writing to the same people twice.
  notifiedAt DateTime?

  /// One row per address. A visitor who submits twice has not signed up twice,
  /// and a holding page is exactly the kind of screen people reload.
  @@unique([shopId, email])
  @@index([shopId])
}

/// One visit to a storefront page.
///
/// The documentation asks for "visits grouped by IP address", and that phrase is
/// doing the work: this counts *people*, not requests, by storing a hash of the
/// address rather than the address itself. The hash is salted with the server's
/// own secret, so the rows cannot be turned back into addresses even by someone
/// holding the database — a visitor count should not become a list of who
/// visited.
///
/// Storefront only. Nobody wants their own admin sessions counted as traffic.
///
/// Written on every page render, so it is deliberately the smallest row that can
/// answer the question, and it is pruned — see lib/retention.ts. Without that it
/// is the fastest-growing table on the platform and the one that eventually
/// fills the disk.
model Visit {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  /// The page that was viewed, e.g. "/product/blue-shirt".
  path      String
  /// Salted SHA-256 of the visitor's address. Never the address itself.
  visitor   String
  /// Two-letter country from the edge, when the platform knows it.
  country   String?
  /// Where they came from — host only, never the full URL with its query.
  referrer  String?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, visitor])
}

/// One file a merchant has uploaded, and where it lives.
///
/// The uploads themselves are in Blob storage and always were; what was missing
/// was any record of them. A photo attached to a product could be found again
/// only by opening that product, and a photo attached to nothing at all could
/// not be found at all — it was in the bucket, paid for, and invisible.
///
/// Listing the bucket is not an alternative. Storage keys are grouped by what
/// the file is for ("products/", "logos/") and not by which shop uploaded it,
/// so a bucket listing would show every merchant on the platform each other's
/// pictures. The row is what makes the library one shop's own.
model MediaAsset {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  /// The public Blob URL. Unique because the same upload is one asset.
  url       String   @unique
  /// What the merchant called the file on their computer, for searching by.
  filename  String
  /// "png", "jpg", "webp", "svg" — the detected format, not the claimed one.
  format    String
  /// Bytes, so the library can say what the storage is being spent on.
  size      Int      @default(0)
  /// Which upload field it came from: "products", "logos", "sections".
  folder    String   @default("")
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

// A URL that should send visitors somewhere else instead of 404ing.
//
// Deliberately NOT per-environment: a redirect is about the shape of the site's
// URLs, which both environments share, and a link someone bookmarked or a
// search engine indexed doesn't care which copy of the store it lands on.
//
// Created automatically when a page's slug changes, and by hand for links that
// went dead some other way (a collection deleted long ago, a URL printed on
// packaging). Checked by the dynamic routes just before they would 404.
model Redirect {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  fromPath  String // "/collections/sale" — always starts with /
  toPath    String // "/shop" or a full https:// address
  isActive  Boolean  @default(true)
  hits      Int      @default(0) // how often it has actually saved someone
  note      String   @default("") // why it exists, for whoever reads this later
  createdAt DateTime @default(now())

  @@unique([shopId, fromPath])
  @@index([isActive])
}

// An admin-uploaded font file, stored in Blob storage.
//
// The *file* is an asset; which font the store actually uses is a theme token
// ("custom:<id>" in ThemeSettings.tokens), so a font can be uploaded once and
// then applied to headings, body text, both or neither.
//
// Only genuine font files land here — see validateFontFile() in
// lib/font-validation.ts for the magic-byte check that gates the upload.
model FontAsset {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  name      String // admin-facing label, defaults to the filename
  url       String // Blob storage URL
  format    String // "woff2" | "woff" | "ttf" | "otf" — drives the @font-face format()
  sizeBytes Int
  createdAt DateTime @default(now())

  // Malware-scan audit trail (see lib/virus-scan.ts). Recorded rather than
  // merely acted on, so it stays visible later which files were actually
  // checked and which predate — or were uploaded without — a configured
  // scanner. "unscanned" is an honest state, not a failure.
  scanStatus   String   @default("unscanned") // "clean" | "unscanned"
  scanProvider String   @default("none")
  scanDetail   String   @default("")
  sha256       String   @default("")
  scannedAt    DateTime @default(now())

  @@index([shopId])
}

// A floating contact button (WhatsApp, Instagram, a chat link, …).
//
// `scope` decides which pages it appears on; see stickyButtonMatchesPath() in
// lib/sticky-buttons.ts.
model StickyButton {
  id        String  @id @default(cuid())
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  kind      String // "WHATSAPP" | "INSTAGRAM" | "MESSENGER" | "EMAIL" | "PHONE" | "LINK"
  label     String // accessible label / tooltip
  value     String // phone number, handle, email or URL depending on `kind`
  message   String  @default("") // prefilled text where the channel supports it
  scope     String  @default("ALL") // "HOME" | "SHOPPING" | "ALL"
  iconKind  String  @default("BUILTIN") // "BUILTIN" | "UPLOAD"
  iconValue String  @default("") // builtin icon key, or the uploaded icon's URL
  color     String  @default("#25D366")
  order     Int     @default(0)
  isVisible Boolean @default(true)

  @@index([shopId])
}

// Per-environment design tokens for the visual customizer — colors,
// typography, corner radius, button style, spacing, container width.
//
// Stored as a single JSON blob rather than a column per token on purpose:
// the token set is expected to grow as the customizer does, and adding a
// token shouldn't need a migration. lib/theme-tokens.ts owns the shape, the
// defaults, and the narrowing — same "defaults + merge" pattern as
// lib/global-edits.ts and lib/site-text.ts, so a missing or partial row is
// never a broken storefront.
model ThemeSettings {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  /// Which of the platform's themes this storefront uses. A string rather than
  /// an enum because themes ship and retire far more often than a migration is
  /// worth, and lib/themes/registry.ts falls back on an unknown key rather than
  /// letting a retired theme take a storefront offline.
  themeKey  String   @default("aurora")
  tokens    Json
  /// What this storefront *arranges*, as opposed to what it paints: which
  /// header, product card, grid and footer it uses, and which of the theme's
  /// behaviours are switched on.
  ///
  /// A blob rather than a column per slot, following `tokens` directly above —
  /// slots and features are added far more often than a migration is worth, and
  /// lib/theme-layout.ts is the one validator, so an unknown variant falls back
  /// rather than reaching a component.
  ///
  /// Empty means "whatever the theme says", which is what every existing row
  /// means, because none of them has one.
  layout    Json     @default("{}")
  updatedAt DateTime @updatedAt

  /// One row per business type, not per shop. A merchant who switches to a blog
  /// and back finds their store's theme and colours exactly as they left them.
  businessType BusinessType @default(ECOMMERCE)

  @@unique([shopId, businessType])
}

// Admin-editable UI copy (button labels, headings, microcopy). Every key
// also has a hardcoded fallback in lib/site-text.ts, so a missing row here
// is never a broken page — see that file for the merge logic.
model SiteText {
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  key       String
  value     String
  group     String // admin-UI grouping, e.g. "Homepage", "Product", "Cart & Checkout"
  updatedAt DateTime @updatedAt

  @@id([shopId, key])
  @@index([shopId])
}

// A storefront page (the homepage plus any admin-created custom pages),
// built from an ordered list of Sections — the admin-panel "Shopify-style"
// content control layer. slug "home" is reserved for the homepage.
//
// Also doubles as the single directory of "things the header/footer menu
// can point at" (see MenuItem below) — every navigable destination on the
// site is a Page row, even ones that aren't Section-rendered:
//   - category   set  -> auto-created 1:1 with a Category (see
//                        app/admin/categories/actions.ts), lives at
//                        /collections/<category.slug>. `title` is never
//                        read for these — the category's own `name` is the
//                        live source of truth (see lib/data/menus.ts).
//   - routePath  set  -> a fixed utility route with its own hardcoded JSX
//                        (Shop/Cart/Contact/Track Order) — this row exists
//                        purely so the menu picker has something to select;
//                        it renders nothing itself and has no Sections.
//   - neither set     -> a normal Section-rendered page: Home/About/FAQ
//                        (isSystem, dedicated route files) or a custom page
//                        (rendered at /p/<slug>).
// Deleting a Category cascades to delete its Page here, which in turn
// cascades to delete any MenuItem pointing at it — a stale nav link can't
// outlive the collection it pointed to.
model Page {
  id             String     @id @default(cuid())
  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId         String
  slug           String
  title          String
  isSystem       Boolean    @default(false) // true for Home/About/FAQ — cannot be deleted
  /// A stable name for a page the platform itself puts there: "home", "about",
  /// "faq". The slug used to serve this purpose, which is why the address could
  /// not be edited — renaming a page moved the thing every route looked it up
  /// by. NULL on every page a merchant made.
  systemKey      String?
  isPublished    Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  sections       Section[]
  category       Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String?
  routePath      String? // e.g. "/shop", "/cart" — see comment above
  menuItems      MenuItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // One "home" page per shop, and one collection page per category.
  /// Which kind of business this page belongs to. A shop that switches type
  /// gets that type's pages; switching back brings the originals back untouched.
  businessType BusinessType @default(ECOMMERCE)

  @@unique([shopId, businessType, slug])
  @@unique([shopId, businessType, systemKey])
  @@unique([shopId, categoryId])
  @@index([shopId])
}

// One content block on a Page. `data` shape depends on `type` — validated
// in the admin server action, not the DB (see lib/data/pages.ts).
model Section {
  id        String      @id @default(cuid())
  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  page      Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  type      SectionType
  order     Int
  isVisible Boolean     @default(true)
  data      Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([pageId])
  @@index([shopId])
}

/// One file from a theme.
///
/// Text is kept inline: it is what the renderer reads on every request and what
/// the code editor writes, and a round trip to object storage for each of two
/// hundred snippets would dominate both. Binary assets — images, fonts — go to
/// blob storage and keep only their URL here, because nothing ever reads their
/// bytes on the server.
/// A custom field on something, in Shopify's shape.
///
/// Themes reach these as `product.metafields.<namespace>.<key>`, and they are
/// how a theme carries anything the base product model has no column for — a
/// care label, a size chart, a badge. Without them a theme that uses one does
/// not fail; it renders the page with that piece silently missing, which is
/// the worst of both outcomes.
///
/// Owner is a type and an id rather than a relation per model, because the set
/// of things that can carry one grows and a nullable foreign key per owner
/// would mean a migration each time. The trade is that the database cannot
/// enforce the reference, so lib/data/metafields.ts is the only writer and it
/// checks the owner exists first.
model Metafield {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  /// "product" | "collection" | "page" | "shop"
  ownerType String
  /// The owning row's id, or "" for shop-level fields, which have no row.
  ///
  /// Empty string rather than null, and that is deliberate. Under SQL's default
  /// rule two nulls are never equal, so a nullable column inside the unique key
  /// below would let the same shop-level field be written twice — the one case
  /// the constraint exists to prevent. Postgres can be told otherwise with
  /// NULLS NOT DISTINCT, but Prisma does not generate that, so the schema and
  /// the database would disagree about an index. "" collides with "" and needs
  /// neither exception.
  ownerId   String @default("")

  /// Shopify splits the name in two so an app's fields cannot collide with a
  /// merchant's. "custom" is the namespace a merchant's own fields live in.
  namespace String
  key       String

  /// One of Shopify's metafield types — see lib/metafields.ts for the set we
  /// accept. Stored rather than inferred: "1" is a number to a human and a
  /// string to a theme, and only the declared type settles it.
  type  String
  /// Always text. Numbers and booleans are cast on the way out, so one column
  /// serves every type and no migration is needed to add another.
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One value per field per owner. Saving the same field twice is an edit.
  @@unique([shopId, ownerType, ownerId, namespace, key])
  @@index([shopId, ownerType, ownerId])
}

/// A slice of the world a storefront can look different for.
///
/// Which region a visitor gets is decided from the country the edge resolves
/// from their connection — see lib/region.ts, which is deliberate about why it
/// reads that header and not the forwarded one.
///
/// A named set of links the merchant builds once and points at wherever it is
/// wanted. There used to be exactly two, fixed by MenuItem.location — a header
/// one and a footer one — so the same links could not be reused in both places
/// and no third menu could exist at all.
///
/// Which menu appears where is a *slot* assignment held on StoreSettings, not a
/// property of the menu, so the same menu can fill both slots and swapping them
/// moves no links.
model Menu {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  /// What the merchant calls it, e.g. "Main menu".
  name   String
  /// Stable identifier, so renaming a menu never breaks an assignment.
  handle String

  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Navigation belongs to a kind of business. A restaurant switching back to
  /// a shop finds the shop's own menus intact, and neither inherits the other's
  /// links to things it does not have.
  businessType BusinessType @default(ECOMMERCE)

  @@unique([shopId, businessType, handle])
  @@index([shopId])
}

model MenuItem {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId String

  /// Superseded by `menu`. Kept until the data has been observed migrated, so
  /// a rollback still has somewhere to read from; nothing reads it now.
  location   MenuLocation?
  groupLabel String?
  label      String
  href       String
  page       Page?         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId     String?
  order      Int
  isVisible  Boolean       @default(true)

  /// Self-relation for dropdowns. Deliberately only two levels deep: a third
  /// tier is unusable on touch and hides the very items it was added to
  /// surface, so nesting a child under a child is refused in the editor rather
  /// than merely discouraged.
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children MenuItem[] @relation("MenuItemChildren")

  /// The kind of business this item's menu belongs to.
  ///
  /// Duplicated from the parent menu rather than joined for it: the tenant
  /// client filters by columns on the row it is querying, and a link that
  /// escapes that filter is a restaurant's header pointing at a clothing
  /// collection, which is exactly what this partition exists to stop.
  businessType BusinessType @default(ECOMMERCE)

  @@index([shopId, menuId])
  @@index([pageId])
  @@index([parentId])
}

// A buyer asking about a BULK or CUSTOM product.
//
// Kept separate from Order on purpose: an enquiry has no payment, no shipping
// and no line items, and treating it as a half-filled order would mean every
// revenue query had to remember to exclude it. The two only meet if an enquiry
// is won and someone raises a real order from it.
model Enquiry {
  id           String        @id @default(cuid())
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId       String
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  /// Snapshot, so the enquiry still reads correctly if the product is renamed
  /// or deleted — the same reasoning as OrderItem's title snapshot.
  productTitle String
  name         String
  email        String
  phone        String
  company      String?
  quantity     Int?
  message      String
  /// CUSTOM products: the buyer's answers, keyed by the field ids in
  /// Product.customFields.
  details      Json?
  status       EnquiryStatus @default(NEW)
  /// Free-text notes the seller adds while working the enquiry.
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([shopId, status, createdAt])
  @@index([productId])
}

/// A blog post.
///
/// Not a Page. Pages are a handful of system pages composed of sections; posts
/// are numerous, ordered by date, and carry an author and an excerpt. Two
/// hundred posts in the Pages admin would ruin it.
///
/// One blog per shop rather than many. Shopify allows several and almost nobody
/// uses more than one; the cost of that generality is a handle in every route
/// and a container to manage. Grouping is `tags` instead.
model Article {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  slug       String
  title      String
  /// Shown in listings. Falls back to the opening of the body when empty, so a
  /// merchant who never writes one still gets a readable card.
  excerpt    String?
  /// Rich text. A post is written, not arranged, so it is one field rather than
  /// a canvas of sections.
  body       String
  coverImage String?
  /// Free text rather than a relation to User: a shop may credit a guest writer,
  /// and a staff member leaving must not orphan their posts.
  authorName String?

  status      ArticleStatus @default(DRAFT)
  /// Set the first time it is published, and kept afterwards, so re-publishing an
  /// edited post does not move it to the top of the blog.
  publishedAt DateTime?

  tags String[] @default([])

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId, status, publishedAt])
}

/// When a shop is open, one row per weekday.
///
/// `day` is 0–6 with 0 = Sunday, matching JavaScript's getDay() so no conversion
/// is needed anywhere it is rendered.
model OpeningHours {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  day        Int
  /// "09:00" / "17:30", local to the shop. Stored as text rather than a time:
  /// these are opening hours on a sign, not instants, and a timezone-aware type
  /// would invite a conversion that is always wrong somewhere.
  opensAt    String?
  closesAt   String?
  /// Closed all day. Distinct from "no hours set", which shows nothing at all.
  closed     Boolean @default(false)
  /// A second service, for a kitchen that shuts between lunch and dinner.
  reopensAt  String?
  reclosesAt String?

  @@unique([shopId, day])
}

/// Somewhere a shop physically is.
model Location {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId String

  name    String
  address String
  city    String?
  phone   String?
  /// A link to whatever map the merchant uses. A link rather than an embed:
  /// an embedded map is a third-party script on a merchant's own domain.
  mapUrl  String?

  /// The one shown when a section names no location.
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, order])
}
